<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Buffalo Jumpstart</title>
<link rel="icon" href="/static/img/icon-192.png">
<link rel="apple-touch-icon" href="/static/img/icon-192.png">
<meta name="theme-color" content="#1C1C1C">
<link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/"><img src="/static/img/mark-180.png" alt="">Buffalo Jumpstart</a>
    <% if (user) { %>
      <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" data-menu-toggle>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <nav class="nav" data-menu>
        <a href="/course" class="<%= /^\/(course|video|quiz|complete)/.test(path) ? 'active' : '' %>">My course</a>
        <a href="/workshop" class="<%= path.startsWith('/workshop') ? 'active' : '' %>">Workshop &amp; Zoom</a>
        <% if (showTeam) { %><a href="/team" class="<%= path.startsWith('/team') ? 'active' : '' %>">My group</a><% } %>
        <% if (user.is_admin) { %><a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a><% } %>
        <a href="/account" class="<%= path.startsWith('/account') ? 'active' : '' %>">Account</a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Log out</button></form>
      </nav>
    <% } %>
  </div>
</header>
<% if (flash) { %>
  <div class="wrap" style="padding-bottom:0">
    <div class="alert <%= flash.type === 'ok' ? 'alert-ok' : 'alert-warn' %>" role="status"><%= flash.text %></div>
  </div>
<% } %>
