<%- include('partials/head') %>
<%
  var label = video.kind === 'welcome' ? 'Welcome' : video.kind === 'congrats' ? 'Congratulations' : 'Module ' + mod.number + ' of ' + course.modulesTotal;
  var quizNeeded = mod && mod.quizLive;
%>
<main class="wrap">
  <a href="/course" class="row small" style="text-decoration:none;font-weight:600;margin-bottom:12px;min-height:44px"><%- u.icon('back') %>My course</a>
  <div class="grid-2">
    <section class="stack">
      <div>
        <div class="eyebrow"><%= label %></div>
        <h1 style="margin-top:4px"><%= video.title %></h1>
      </div>
      <div class="player">
        <% if (video.youtube_id) { %>
          <div id="yt" data-video-id="<%= video.youtube_id %>" data-complete-url="/api/videos/<%= video.id %>/complete" data-csrf="<%= csrf %>"></div>
        <% } else { %>
          <div class="placeholder-video" style="position:absolute;inset:0">This video is coming soon.</div>
        <% } %>
      </div>

      <!-- Shown when the video has been watched to the end -->
      <div class="card stack" data-after-watch <%= watched ? '' : 'hidden' %>>
        <% if (video.kind === 'module') { %>
          <% if (quizNeeded) { %>
            <div class="row"><span class="pill pill-green">Video complete</span><span class="small muted">The Module <%= mod.number %> quiz is unlocked.</span></div>
            <a class="btn btn-block" href="/quiz/<%= video.id %>"><%- u.icon('quiz') %><%= mod.state === 'done' ? 'Retake' : 'Take' %> the Module <%= mod.number %> quiz</a>
          <% } else { %>
            <div class="row"><span class="pill pill-green">Video complete</span></div>
            <a class="btn btn-block" href="/course">Back to my course</a>
          <% } %>
        <% } else if (video.kind === 'congrats') { %>
          <div class="row"><span class="pill pill-green">Certificate unlocked</span></div>
          <a class="btn btn-block" href="/complete"><%- u.icon('award') %>Get my certificate &amp; next steps</a>
        <% } else { %>
          <a class="btn btn-block" href="/course">Start Module 1</a>
        <% } %>
      </div>
      <div class="alert alert-warn" data-before-watch <%= watched ? 'hidden' : '' %>>
        <% if (video.kind === 'welcome') { %>
          Watch to the end to unlock Module 1. Skipping and fast-forwarding are fine.
        <% } else if (video.kind === 'congrats') { %>
          Watch to the end to unlock your certificate.
        <% } else { %>
          Watch to the end<%= quizNeeded ? ' to unlock the quiz' : ' to unlock the next module' %>. Skipping and fast-forwarding are fine.
        <% } %>
      </div>
    </section>

    <aside class="stack">
      <div class="card stack small">
        <h3>Course videos</h3>
        <% course.modules.forEach(function (m) { %>
          <div class="row" style="gap:10px;<%= m.id === video.id ? 'font-weight:700' : '' %>">
            <span style="color:<%= m.state === 'done' ? 'var(--green)' : m.state === 'locked' ? '#888' : 'var(--red)' %>"><%- u.icon(m.state === 'done' ? 'check' : m.state === 'locked' ? 'lock' : 'play', 16) %></span>
            <% if (m.state === 'locked') { %><span class="muted">Module <%= m.number %> · <%= m.title %></span>
            <% } else { %><a href="/video/<%= m.id %>" style="color:inherit;text-decoration:none">Module <%= m.number %> · <%= m.title %></a><% } %>
          </div>
        <% }) %>
      </div>
    </aside>
  </div>
</main>
<script src="/static/js/player.js"></script>
<%- include('partials/foot') %>
