<%- include('../partials/admin-start') %>
<div><h1>Videos &amp; quizzes</h1><p class="muted" style="margin-top:4px">Buffalo Jumpstart · videos play in this order. Paste a YouTube link to change a video.</p></div>
<div class="stack" style="gap:10px">
<% var n = 0; videos.forEach(function (v) { if (v.kind === 'module') n++; %>
  <div class="card tight stack" style="gap:10px">
    <div class="spread">
      <div>
        <div class="eyebrow" style="font-size:12px"><%= v.kind === 'welcome' ? 'Welcome · skippable, no quiz' : v.kind === 'congrats' ? 'Congratulations · must watch to unlock certificate' : 'Module ' + n %></div>
        <div style="font-weight:700"><%= v.title %></div>
      </div>
      <% if (v.kind === 'module') { %>
        <div class="row" style="gap:8px">
          <% if (v.quiz_status === 'approved') { %><span class="pill pill-green">Quiz live · <%= v.qcount %> Qs</span>
          <% } else if (v.quiz_status === 'draft') { %><span class="pill pill-gold">Quiz draft · <%= v.qcount %> Qs</span>
          <% } else { %><span class="pill pill-grey">No quiz yet</span><% } %>
          <a class="btn btn-sm btn-ghost" href="/admin/videos/<%= v.id %>/quiz"><%= v.quiz_status === 'none' ? 'Add quiz' : 'Edit quiz' %></a>
        </div>
      <% } else if (!v.youtube_id) { %><span class="pill pill-gold">Video not added yet</span><% } %>
    </div>
    <details>
      <summary class="small" style="cursor:pointer;font-weight:600;color:var(--red);min-height:32px">Edit title or video link</summary>
      <form method="post" action="/admin/videos/<%= v.id %>" class="form-grid" style="margin-top:10px;align-items:end">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="t<%= v.id %>">Title</label><input id="t<%= v.id %>" name="title" type="text" value="<%= v.title %>"></div>
        <div class="field"><label for="y<%= v.id %>">YouTube link</label><input id="y<%= v.id %>" name="youtube" type="text" value="<%= v.youtube_id ? 'https://youtu.be/' + v.youtube_id : '' %>" placeholder="https://youtu.be/..."></div>
        <div><button class="btn btn-sm" type="submit">Save</button></div>
      </form>
    </details>
  </div>
<% }) %>
</div>
<p class="small muted">Until a module's quiz is approved, watching the video to the end is enough to unlock the next module.</p>
<%- include('../partials/admin-end') %>
