<%- include('../partials/admin-start') %>
<div><h1>Approvals</h1><p class="muted" style="margin-top:4px">New registrations from the registration link. Check the details and the upline, then approve.</p></div>
<div class="card tight small row" style="justify-content:space-between">
  <span>Registration link to share: <b><%= baseUrl %>/register</b></span>
</div>

<% if (!pending.length) { %>
  <div class="card"><p class="muted">No registrations waiting.</p></div>
<% } %>
<% pending.forEach(function (p) { %>
  <div class="card stack">
    <div class="spread" style="align-items:flex-start">
      <div>
        <h2><%= p.name %></h2>
        <p class="small muted">Registered <%= u.fmtDateTime(p.created_at) %></p>
      </div>
      <% if (!p.upline_name) { %><span class="pill pill-gold">Upline not found</span><% } %>
    </div>
    <dl class="kv">
      <dt>Adviser code</dt><dd><%= p.agent_code %></dd>
      <dt>Email</dt><dd><%= p.email %></dd>
      <dt>Mobile</dt><dd><%= p.mobile %></dd>
      <dt>Upline entered</dt><dd><%= p.upline_code %><%= p.upline_name ? ' — ' + p.upline_name : ' (not in the portal)' %></dd>
    </dl>
    <form method="post" action="/admin/approvals/<%= p.id %>/approve" class="row" style="align-items:flex-end">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field" style="flex:1;min-width:200px">
        <label for="up<%= p.id %>">Upline adviser code (correct it if needed)</label>
        <input id="up<%= p.id %>" name="upline" type="text" value="<%= p.upline_code %>" autocapitalize="characters">
      </div>
      <button class="btn" type="submit" data-busy="Approving…">Approve</button>
    </form>
    <details>
      <summary class="small" style="cursor:pointer;color:var(--red);font-weight:600;min-height:32px">Reject instead</summary>
      <form method="post" action="/admin/approvals/<%= p.id %>/reject" class="stack" style="margin-top:10px" data-confirm="Reject this registration and email the person?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="rs<%= p.id %>">Reason (optional, included in the email)</label><input id="rs<%= p.id %>" name="reason" type="text"></div>
        <button class="btn btn-ghost" type="submit">Reject and email</button>
      </form>
    </details>
  </div>
<% }) %>

<% if (recent.length) { %>
  <h2>Recently decided</h2>
  <div class="table-wrap"><table class="t">
    <thead><tr><th>Name</th><th>Code</th><th>Decision</th><th>By</th><th>When</th></tr></thead>
    <tbody>
    <% recent.forEach(function (r) { %>
      <tr><td><a class="name" href="/admin/advisers/<%= r.id %>"><%= r.name %></a></td><td><%= r.agent_code %></td>
        <td><span class="pill <%= r.status === 'rejected' ? 'pill-red' : 'pill-green' %>"><%= r.status === 'rejected' ? 'Rejected' : 'Approved' %></span></td>
        <td><%= r.approver || '—' %></td><td class="small"><%= u.fmtDate(r.approved_at) %></td></tr>
    <% }) %>
    </tbody></table></div>
<% } %>
<%- include('../partials/admin-end') %>
