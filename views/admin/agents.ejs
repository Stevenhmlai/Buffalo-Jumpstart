<%- include('../partials/admin-start') %>
<div class="page-head" style="margin:0">
  <div><h1>Advisers</h1><p><%= rows.length %> shown</p></div>
  <div class="row">
    <a class="btn btn-ghost btn-sm" href="/admin/changes">Upline change log</a>
    <a class="btn btn-ghost btn-sm" href="/admin/export/advisers.xlsx"><%- u.icon('download', 16) %>Excel</a>
    <a class="btn btn-sm" href="/admin/advisers/new">Add adviser</a>
  </div>
</div>
<form method="get" class="row" role="search">
  <label class="sr-only" for="q">Search</label>
  <input id="q" type="search" name="q" value="<%= search %>" placeholder="Search name, code, upline or email" style="flex:1;min-width:220px">
  <label class="sr-only" for="s">Show</label>
  <select id="s" name="s" style="width:auto">
    <% [['all','Everyone'],['training','In training'],['idle','Idle 7+ days'],['completed','Completed'],['admins','Admins'],['inactive','Inactive']].forEach(function (o) { %>
      <option value="<%= o[0] %>" <%= status === o[0] ? 'selected' : '' %>><%= o[1] %></option>
    <% }) %>
  </select>
  <button class="btn btn-dark" type="submit">Search</button>
</form>
<div class="table-wrap">
  <table class="t">
    <thead><tr><th>Adviser</th><th>Upline</th><th>Approved</th><th>Progress</th><th>Batch</th><th>Status</th></tr></thead>
    <tbody>
    <% if (!rows.length) { %><tr><td colspan="6" class="muted">No advisers match.</td></tr><% } %>
    <% rows.forEach(function (r) {
      var cls = r.statusLabel === 'Completed' ? 'pill-green' : /Idle|Not started ·/.test(r.statusLabel) ? 'pill-gold' : r.status !== 'active' ? 'pill-red' : r.statusLabel === 'In progress' ? 'pill-dark' : 'pill-grey'; %>
      <tr>
        <td><a class="name" href="/admin/advisers/<%= r.id %>"><%= r.name %></a><div class="sub"><%= r.agent_code %><%= r.is_admin ? ' · Admin' : '' %></div></td>
        <td><%= r.upline_name || '—' %><div class="sub"><%= r.upline_code || '' %></div></td>
        <td class="small"><%= u.fmtDate(r.approved_at) || '—' %></td>
        <td><% if (r.trainee) { %><div class="mini-bar"><div class="bar"><span style="width:<%= r.course.percent %>%"></span></div><span class="tiny"><%= r.course.modulesDone %>/<%= r.course.modulesTotal %></span></div><% } else { %><span class="tiny muted">—</span><% } %></td>
        <td><%= r.batch || '—' %></td>
        <td><span class="pill <%= cls %>"><%= r.statusLabel %></span></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/admin-end') %>
