<%- include('partials/head') %>
<main class="wrap-narrow">
  <h1 class="auth-title" style="margin-top:12px">Set a new password</h1>
  <p class="auth-sub"><%= u.dn(who) %> · <%= who.agent_code %></p>
  <div class="card stack">
    <% if (error) { %><div class="alert alert-err" role="alert"><%= error %></div><% } %>
    <form method="post" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required>
        <span class="hint">At least 8 characters.</span>
      </div>
      <div class="field">
        <label for="password2">Confirm new password</label>
        <input id="password2" name="password2" type="password" autocomplete="new-password" required>
      </div>
      <button class="btn btn-block" type="submit">Save password</button>
    </form>
  </div>
</main>
<%- include('partials/foot') %>
